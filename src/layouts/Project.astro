---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';

type Props = CollectionEntry<'projects'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
const { pathname } = Astro.url;

const postId = pathname.replace(/^\/projects\/|\/$/g, '');

const posts = (await getCollection('projects')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base title={title} description={description}>
	<div class="project-container">
		<article>
			<div class="hero-image">
				{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
			</div>
			<div class="prose">
				<div class="title">
					<h1>{title}</h1>
				</div>
				<slot />
			</div>
		</article>
		<aside>
			<h2>All Projects</h2>
			<ul>
				{posts.map((post) => <li>
					{(post.id === postId) ? 
						<span class="current-project">{post.data.title}</span>
						:
						<a href={`/projects/${post.id}/`}>{post.data.title}</a>}
				</li>)}
			</ul>
		</aside>
	</div>
</Base>
<style>
	.project-container {
		display: flex;

		h1 { margin-top: 0; }
		aside { 
			border-left: 1px solid #000000;
			margin-left: 30px;
			padding-left: 30px;
			width: 230px; 
			flex-shrink: 0;

			h2 { 
				margin-top: 0;
				margin-bottom: 30px;
			}
			ul { 
				padding: 0;

				li { 
					list-style: none; 
					margin: 16px 0;

					.current-project { font-weight: bold; }
				}
			}
		}
		article { 
			flex-grow: 1;
			max-width: 100%;
			min-width: 0;

			.hero-image img { margin-bottom: 2em; }
			.prose {
				pre { white-space: pre-wrap; }
				img {
					width: 100%;
					height: auto;
				}
			}																						
		}
	}
</style>